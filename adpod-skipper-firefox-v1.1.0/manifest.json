{
  "manifest_version": 3,
  "name": "AdPod Skipper",
  "version": "1.1.0",
  "description": "Menangani hingga 10 iklan berurutan secara otomatis: blokir jaringan, sembunyikan slot, lewati iklan video.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "AdPod Skipper",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "scripts": [
      "shared.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "shared.js",
        "content/adapters.js",
        "content/engine.js",
        "content/cosmetic.js"
      ]
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://www.youtube-nocookie.com/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "content/yt-main.js"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "base-0",
        "enabled": true,
        "path": "rules/base-0.json"
      },
      {
        "id": "base-1",
        "enabled": false,
        "path": "rules/base-1.json"
      },
      {
        "id": "base-2",
        "enabled": false,
        "path": "rules/base-2.json"
      },
      {
        "id": "base-3",
        "enabled": false,
        "path": "rules/base-3.json"
      },
      {
        "id": "base-4",
        "enabled": false,
        "path": "rules/base-4.json"
      },
      {
        "id": "base-5",
        "enabled": false,
        "path": "rules/base-5.json"
      },
      {
        "id": "base-6",
        "enabled": false,
        "path": "rules/base-6.json"
      },
      {
        "id": "base-7",
        "enabled": false,
        "path": "rules/base-7.json"
      },
      {
        "id": "extra-0",
        "enabled": false,
        "path": "rules/extra-0.json"
      },
      {
        "id": "extra-1",
        "enabled": false,
        "path": "rules/extra-1.json"
      },
      {
        "id": "extra-2",
        "enabled": false,
        "path": "rules/extra-2.json"
      },
      {
        "id": "extra-3",
        "enabled": false,
        "path": "rules/extra-3.json"
      },
      {
        "id": "extra-4",
        "enabled": false,
        "path": "rules/extra-4.json"
      },
      {
        "id": "extra-5",
        "enabled": false,
        "path": "rules/extra-5.json"
      }
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "adpod-skipper@example.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  }
}